# Production Environment Variables for Netlify
# These should be set in Netlify Dashboard: Site Settings > Environment Variables

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
VITE_API_URL=/api

# Supabase Configuration
VITE_SUPABASE_URL=https://kxfoliaudjwrxgvwudjc.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application Settings
NODE_ENV=production
VITE_APP_NAME=TechMasterAI
VITE_APP_VERSION=1.0.0

# API Configuration
MAX_TOKENS_PER_REQUEST=300
RATE_LIMIT_REQUESTS_PER_MINUTE=10
CONVERSATION_HISTORY_LIMIT=5
